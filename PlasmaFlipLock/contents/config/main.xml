<?xml version="1.0" encoding="UTF-8"?>
<!--
    PlasmaFlipLock — settings schema for the lock screen.

    The greeter (kscreenlocker) exposes these entries to the lock screen QML
    through its "config" context property, with user overrides read from
    kscreenlockerrc group "[Greeter][LnF]".

    Change a setting without editing files (per user), e.g.:

      kwriteconfig6 -file kscreenlockerrc -group Greeter -group LnF \
                    -key showWeather true

    (write the real command with double dashes before each flag)
    Keys are consumed in contents/LockScreenUi.qml (see cfgValue()).
-->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">

    <entry name="showBattery" type="Bool">
      <label>Show battery percentage and charging state in the status strip.</label>
      <default>true</default>
    </entry>

    <entry name="showWeather" type="Bool">
      <label>Show current temperature in the status strip (requires weatherSource).</label>
      <default>false</default>
    </entry>

    <entry name="weatherSource" type="String">
      <label>Weather dataengine source: "provider|City", e.g. "bbcukmet|London".</label>
      <default></default>
    </entry>

    <entry name="blurWallpaper" type="Bool">
      <label>Blur the lock screen wallpaper (GPU, fullscreen).</label>
      <default>true</default>
    </entry>

    <entry name="clockScale" type="Double">
      <label>Size multiplier for the flip clock (0.6 – 1.4).</label>
      <default>1.0</default>
    </entry>

  </group>
</kcfg>
